# Gitalk 评论（文章底部）
# 需先在 GitHub 创建一个 OAuth App：https://github.com/settings/developers
#   Authorization callback URL 填写你的站点域名，例如 https://geektutu.com
# 评论会以 issue 形式写入下方 repo 仓库
PUBLIC_GITALK_CLIENT_ID=
PUBLIC_GITALK_CLIENT_SECRET=
# 存放评论 issue 的仓库与所有者
PUBLIC_GITALK_OWNER=geektutu
PUBLIC_GITALK_REPO=geektutu.github.io
# 仓库管理员（多个用逗号分隔，需有写权限以创建 issue）
PUBLIC_GITALK_ADMIN=geektutu

# 赞赏码（文章底部，支付宝 / 微信）
# 填写要生成二维码的内容（如支付宝/微信收款链接或赞赏码文本），
# 前端会用 qrcode 动态生成二维码图片。留空则该赞赏码不展示。
PUBLIC_TIP_ALIPAY=
PUBLIC_TIP_WECHAT=
