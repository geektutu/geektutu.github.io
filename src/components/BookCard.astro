---
import { getBookChapters, type Book } from '../lib/books';
import { getDict } from '../lib/i18n';
import BookCover from './BookCover.astro';

interface Props {
  book: Book;
  index?: number;
}
const { book, index = 0 } = Astro.props;
const t = getDict(book.lang);
const chapters = await getBookChapters(book.data.id, book.lang);
const href = `${book.lang === 'en' ? '/en' : ''}/books/${book.data.id}`;
---

<a
  href={href}
  class="group flex flex-col overflow-hidden rounded-2xl border border-line bg-paper-soft transition-all hover:-translate-y-1 hover:shadow-lg hover:shadow-ink/5"
  style={{ '--i': index }}
>
  <div class="relative aspect-[4/3] overflow-hidden">
    <BookCover title={book.data.title} ratio="4/3" author={t.siteName} />
    <span class="absolute left-3 top-3 rounded-full bg-ink/80 px-2.5 py-1 text-xs text-paper backdrop-blur">
      {t.book.chapters(chapters.filter((c) => c.post).length)}
    </span>
  </div>
  <div class="flex flex-1 flex-col gap-2 p-5">
    <p class="line-clamp-3 text-sm leading-relaxed text-muted">{book.data.description}</p>
    <span class="mt-auto pt-2 text-sm text-accent opacity-0 transition-opacity group-hover:opacity-100">
      {t.card.startReading}
    </span>
  </div>
</a>
