---
import { pageHref, type Lang } from '../lib/books';
import { getDict } from '../lib/i18n';

interface Props {
  page: number;
  totalPages: number;
  lang: Lang;
}
const { page, totalPages, lang } = Astro.props;
const t = getDict(lang);
const href = (p: number) => pageHref(lang, p);
---

{totalPages > 1 && (
  <nav class="flex items-center justify-center gap-2 no-print" aria-label={lang === 'en' ? 'Pagination' : '分页'}>
    {page <= 1 ? (
      <span class="rounded-full border border-line px-4 py-1.5 text-sm opacity-40" aria-disabled="true">{t.page.prev}</span>
    ) : (
      <a href={href(page - 1)} class="rounded-full border border-line px-4 py-1.5 text-sm transition-colors hover:border-accent/40 hover:text-accent">{t.page.prev}</a>
    )}
    {Array.from({ length: totalPages }, (_, i) => i + 1).map((p) => (
      <a
        href={href(p)}
        class:list={[
          'rounded-full px-3.5 py-1.5 text-sm transition-colors',
          p === page ? 'bg-accent text-white' : 'text-muted hover:text-ink hover:bg-surface',
        ]}
        aria-current={p === page ? 'page' : undefined}
      >
        {p}
      </a>
    ))}
    {page >= totalPages ? (
      <span class="rounded-full border border-line px-4 py-1.5 text-sm opacity-40" aria-disabled="true">{t.page.next}</span>
    ) : (
      <a href={href(page + 1)} class="rounded-full border border-line px-4 py-1.5 text-sm transition-colors hover:border-accent/40 hover:text-accent">{t.page.next}</a>
    )}
  </nav>
)}
