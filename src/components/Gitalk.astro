---
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;

const clientID = import.meta.env.PUBLIC_GITALK_CLIENT_ID;
const clientSecret = import.meta.env.PUBLIC_GITALK_CLIENT_SECRET;
const owner = import.meta.env.PUBLIC_GITALK_OWNER ?? 'geektutu';
const repo = import.meta.env.PUBLIC_GITALK_REPO ?? 'geektutu.github.io';
const admin = ((import.meta.env.PUBLIC_GITALK_ADMIN ?? 'geektutu') as string)
  .split(',')
  .map((s: string) => s.trim())
  .filter(Boolean);

const enabled = Boolean(clientID && clientSecret && repo && owner && admin.length);
---

{enabled && (
  <section class="no-print mt-12 border-t border-line pt-10">
    <p class="mb-6 text-xs font-medium uppercase tracking-[0.2em] text-faint">评论</p>
    <div id="gitalk-container"></div>
  </section>
)}

{enabled && (
  <script
    is:inline
    define:vars={{ id, title, clientID, clientSecret, owner, repo, admin }}
  >
    // 延迟加载：评论容器进入视口后才加载 gitalk 资源，避免拖慢首屏
    const container = document.getElementById('gitalk-container');
    let loaded = false;

    function initGitalk() {
      const gitalk = new Gitalk({
        clientID,
        clientSecret,
        repo,
        owner,
        admin,
        id,
        title,
        language: 'zh-CN',
        distractionFreeMode: false,
      });
      gitalk.render('gitalk-container');
    }

    function loadGitalk() {
      if (loaded) return;
      loaded = true;
      if (window.Gitalk) {
        initGitalk();
        return;
      }
      const link = document.createElement('link');
      link.rel = 'stylesheet';
      link.href = '/css/gitalk.css';
      document.head.appendChild(link);
      const script = document.createElement('script');
      script.src = '/js/gitalk.min.js';
      script.async = true;
      script.onload = initGitalk;
      document.body.appendChild(script);
    }

    if (container && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              loadGitalk();
              observer.disconnect();
            }
          });
        },
        { rootMargin: '200px' },
      );
      observer.observe(container);
    } else if (container) {
      loadGitalk();
    }
  </script>
)}
