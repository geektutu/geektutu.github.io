---
import QRCode from 'qrcode';

const alipay = import.meta.env.PUBLIC_TIP_ALIPAY;
const wechat = import.meta.env.PUBLIC_TIP_WECHAT;
const enabled = Boolean(alipay || wechat);

const opts = {
  type: 'svg' as const,
  margin: 1,
  color: { dark: '#1a1815', light: '#ffffff' },
};
const [alipaySvg, wechatSvg] = await Promise.all([
  alipay ? QRCode.toString(alipay, opts) : null,
  wechat ? QRCode.toString(wechat, opts) : null,
]);
---

{enabled && (
  <section class="no-print mt-10 flex flex-col items-center gap-5 rounded-2xl border border-line bg-paper-soft p-8 text-center">
    <p class="font-display text-lg font-semibold text-ink">如果文章对你有帮助，欢迎赞赏支持 ☕</p>
    <div class="flex flex-wrap items-start justify-center gap-8">
      {alipaySvg && (
        <figure class="flex flex-col items-center gap-2">
          <span
            class="block h-40 w-40 rounded-xl border-2 border-[#1677ff] bg-white p-1 [&>svg]:h-full [&>svg]:w-full"
            set:html={alipaySvg}
          />
          <figcaption class="text-sm text-muted">支付宝</figcaption>
        </figure>
      )}
      {wechatSvg && (
        <figure class="flex flex-col items-center gap-2">
          <span
            class="block h-40 w-40 rounded-xl border-2 border-[#07c160] bg-white p-1 [&>svg]:h-full [&>svg]:w-full"
            set:html={wechatSvg}
          />
          <figcaption class="text-sm text-muted">微信</figcaption>
        </figure>
      )}
    </div>
  </section>
)}
