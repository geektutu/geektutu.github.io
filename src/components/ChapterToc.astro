---
import type { ChapterItem } from '../lib/books';

interface Props {
  bookTitle: string;
  bookId: string;
  chapters: ChapterItem[];
  currentSlug: string;
}
const { bookTitle, bookId, chapters, currentSlug } = Astro.props;

// 分组：按 part 分段，为每章计算全局序号
let counter = 0;
const groups = chapters.map((c) => ({ ...c, num: ++counter }));
const byPart: { part: string; items: typeof groups }[] = [];
for (const c of groups) {
  const key = c.part ?? '—';
  let last = byPart[byPart.length - 1];
  if (!last || last.part !== key) {
    last = { part: key, items: [] };
    byPart.push(last);
  }
  last.items.push(c);
}
---

<nav class="overflow-y-auto px-2 py-4" aria-label="章节目录">
  <a href={`/books/${bookId}`} class="mb-3 block font-display text-sm font-semibold text-ink transition-colors hover:text-accent">
    {bookTitle}
  </a>
  <ul class="space-y-0.5">
    {byPart.map((group) => (
      <li>
        {group.part !== '—' && (
          <div class="mt-3 mb-1 px-2 text-[0.7rem] font-medium uppercase tracking-widest text-faint">
            {group.part}
          </div>
        )}
        <ul>
          {group.items.map((item) => {
            const href = item.post ? `/post/${item.slug}.html` : null;
            const active = item.slug === currentSlug;
            return (
              <li>
                {href ? (
                  <a
                    href={href}
                    class:list={[
                      'toc-link flex items-baseline gap-2 rounded-lg px-2 py-1.5 text-sm',
                      active
                        ? 'bg-accent-soft font-medium text-accent'
                        : 'text-muted hover:bg-surface hover:text-ink',
                    ]}
                    aria-current={active ? 'page' : undefined}
                  >
                    <span class="font-mono text-xs text-faint tabular-nums">{String(item.num).padStart(2, '0')}</span>
                    <span>{item.post?.data.title ?? item.slug}</span>
                  </a>
                ) : (
                  <span class="flex items-baseline gap-2 rounded-lg px-2 py-1.5 text-sm text-faint">
                    <span class="font-mono text-xs tabular-nums">{String(item.num).padStart(2, '0')}</span>
                    <span>{item.slug}</span>
                  </span>
                )}
              </li>
            );
          })}
        </ul>
      </li>
    ))}
  </ul>
</nav>
