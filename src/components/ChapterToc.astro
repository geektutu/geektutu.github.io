---
import type { ChapterItem } from '../lib/books';

interface Props {
  bookTitle: string;
  bookId: string;
  chapters: ChapterItem[];
  currentSlug: string;
}
const { bookTitle, bookId, chapters, currentSlug } = Astro.props;

// 按 part 分段（保持大纲顺序）
const byPart: { part: string; items: ChapterItem[] }[] = [];
for (const c of chapters) {
  const key = c.part ?? '—';
  let last = byPart[byPart.length - 1];
  if (!last || last.part !== key) {
    last = { part: key, items: [] };
    byPart.push(last);
  }
  last.items.push(c);
}
---

<nav class="book-toc px-5 pb-6 pt-5" aria-label="章节目录">
  <!-- 书名 -->
  <a href={`/books/${bookId}`} class="group block">
    <p class="text-[0.65rem] font-medium uppercase tracking-[0.25em] text-faint">Book</p>
    <p
      class="mt-1.5 font-display text-base font-semibold leading-snug text-ink transition-colors group-hover:text-accent"
    >
      {bookTitle}
    </p>
  </a>

  <div class="mt-4 h-px bg-line" aria-hidden="true"></div>

  <!-- 章节列表 -->
  {
    byPart.map((group) => (
      <section class="last:mb-0">
        {group.part !== '—' && (
          <div class="mt-6 mb-1.5 flex items-center gap-2 px-2.5">
            <span class="h-[2px] w-3.5 shrink-0 rounded-full bg-accent/70" aria-hidden="true"></span>
            <span class="font-display text-[0.85rem] font-semibold tracking-wide text-ink">
              {group.part}
            </span>
          </div>
        )}
        <ul>
          {group.items.map((item) => {
            const href = item.post ? `/post/${item.slug}.html` : null;
            const active = item.slug === currentSlug;
            return (
              <li>
                {href ? (
                  <a
                    href={href}
                    class:list={[
                      'toc-link block rounded-lg py-1.5 pr-2 pl-7 text-[0.9rem] leading-relaxed',
                      active
                        ? 'bg-accent-soft font-medium text-accent shadow-[inset_2px_0_0_var(--accent)]'
                        : 'text-ink/85 hover:bg-surface hover:text-ink',
                    ]}
                    aria-current={active ? 'page' : undefined}
                  >
                    {item.short ?? item.post?.data.title ?? item.slug}
                  </a>
                ) : (
                  <span
                    class="block rounded-lg py-1.5 pr-2 pl-7 text-[0.9rem] leading-relaxed text-faint/70 italic"
                    title="待发布"
                  >
                    {item.slug}（待写）
                  </span>
                )}
              </li>
            );
          })}
        </ul>
      </section>
    ))
  }
</nav>
