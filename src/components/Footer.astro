---
const year = new Date().getFullYear();
const beianIcp = import.meta.env.PUBLIC_BEIAN_ICP;
const beianPolice = import.meta.env.PUBLIC_BEIAN_POLICE;
const showBeian = Boolean(beianIcp || beianPolice);
---

<footer class="border-t border-line no-print">
  <div class="mx-auto flex max-w-6xl flex-col items-center gap-2 px-5 py-8 text-center sm:flex-row sm:justify-between sm:text-left">
    <p class="text-sm text-muted">
      © {year} 极客兔兔 · 把技术文章写成书
    </p>
    <div class="flex items-center gap-4 text-sm text-faint">
      <a href="/feed.xml" class="transition-colors hover:text-accent">RSS</a>
      <a href="/about" class="transition-colors hover:text-accent">关于</a>
      <a href="https://github.com/geektutu" target="_blank" rel="noreferrer" class="transition-colors hover:text-accent">GitHub</a>
    </div>
  </div>
  {showBeian && (
    <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-1 border-t border-line px-5 py-3 text-xs text-faint">
      {beianIcp && (
        <a href="https://beian.miit.gov.cn/" target="_blank" rel="noreferrer" class="transition-colors hover:text-accent">
          {beianIcp}
        </a>
      )}
      {beianPolice && (
        <a href="https://beian.mps.gov.cn/" target="_blank" rel="noreferrer" class="transition-colors hover:text-accent">
          {beianPolice}
        </a>
      )}
    </div>
  )}
  <p class="px-5 pb-5 pt-2 text-center text-xs text-faint tabular-nums">
    <span id="busuanzi_container_site_pv" title="总访问量">👁 <span id="busuanzi_value_site_pv"></span></span>
    <span id="busuanzi_container_page_pv" title="本页阅读量"><span class="mx-2">·</span>📚 <span id="busuanzi_value_page_pv"></span></span>
  </p>
</footer>

<!-- 不蒜子访问统计：页面加载完成后异步引入 -->
<script is:inline>
  window.addEventListener('load', function () {
    var s = document.createElement('script');
    s.src = 'https://busuanzi.ibruce.info/busuanzi/2.3/busuanzi.pure.mini.js';
    s.async = true;
    document.body.appendChild(s);
  });
</script>

<style is:global>
  /* 数值未填充（脚本加载失败或请求中）时隐藏统计行，填充后自动显示。
     用 !important 压过 Tailwind preflight 与脚本内联样式，避免出现空图标。 */
  [id^='busuanzi_container_']:has([id^='busuanzi_value_']:empty) {
    display: none !important;
  }
</style>
