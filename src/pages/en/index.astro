---
import Layout from '../../layouts/Layout.astro';
import BookCard from '../../components/BookCard.astro';
import PostCard from '../../components/PostCard.astro';
import Pagination from '../../components/Pagination.astro';
import { getBooks, getPublishedPosts } from '../../lib/books';
import { getDict } from '../../lib/i18n';

const lang = 'en' as const;
const t = getDict(lang);
const POSTS_PER_PAGE = 6;
const books = await getBooks(lang);
const allPosts = await getPublishedPosts(lang);
const totalPages = Math.max(1, Math.ceil(allPosts.length / POSTS_PER_PAGE));
const posts = allPosts.slice(0, POSTS_PER_PAGE);
const featured = books.filter((b) => b.data.featured);
---

<Layout lang={lang} active="home" description={t.defaultDescription}>
  <!-- Hero -->
  <section class="mx-auto max-w-6xl px-5 pt-12">
    <p class="mb-3 text-xs font-medium uppercase tracking-[0.2em] text-accent">{t.home.kicker}</p>
    <h1 class="font-display text-3xl font-semibold leading-tight tracking-tight sm:text-4xl">
      {t.home.titleLead} <span class="italic text-accent">{t.home.titleEm}</span>
    </h1>
  </section>

  <!-- Featured books -->
  {featured.length > 0 && (
    <section class="mx-auto max-w-6xl px-5 pt-10 pb-4">
      <div class="mb-6 flex items-end justify-between">
        <h2 class="font-display text-2xl font-semibold tracking-tight">{t.home.featured}</h2>
        <a href="/en/books" class="text-sm text-muted transition-colors hover:text-accent">{t.home.allBooks}</a>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {featured.map((book, i) => (
          <div class="animate-rise" style={{ 'animation-delay': `${i * 0.08}s` }}>
            <BookCard book={book} index={i} />
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- Latest posts -->
  <section class="mx-auto max-w-6xl px-5 py-12">
    <div class="mb-6 flex items-end justify-between">
      <h2 class="font-display text-2xl font-semibold tracking-tight">{t.home.latest}</h2>
    </div>
    {posts.length > 0 ? (
      <>
        <div class="grid gap-5 md:grid-cols-2">
          {posts.map((post, i) => (
            <div class="animate-rise" style={{ 'animation-delay': `${i * 0.05}s` }}>
              <PostCard post={post} index={i} />
            </div>
          ))}
        </div>
        <div class="mt-10">
          <Pagination lang={lang} page={1} totalPages={totalPages} />
        </div>
      </>
    ) : (
      <p class="text-muted">{t.home.empty}</p>
    )}
  </section>
</Layout>
