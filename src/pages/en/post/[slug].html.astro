---
import Layout from '../../../layouts/Layout.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ChapterToc from '../../../components/ChapterToc.astro';
import ChapterNav from '../../../components/ChapterNav.astro';
import ChapterHeader from '../../../components/ChapterHeader.astro';
import ReadingProgress from '../../../components/ReadingProgress.astro';
import SectionToc from '../../../components/SectionToc.astro';
import SaveLastRead from '../../../components/SaveLastRead.astro';
import Gitalk from '../../../components/Gitalk.astro';
import Tip from '../../../components/Tip.astro';
import { getBookChapters, getAdjacentChapters, gitalkId, postHref, bookHref, readingTime, type Post } from '../../../lib/books';
import { getDict, contentLang } from '../../../lib/i18n';

const lang = 'en' as const;
const t = getDict(lang);

export async function getStaticPaths() {
  const posts = await getCollection('posts-en', ({ data }) => !data.draft);
  return posts.map((p) => ({ params: { slug: p.id }, props: { post: p } }));
}

const { post: rawPost } = Astro.props as { post: CollectionEntry<'posts-en'> };
const post = { ...rawPost, lang } as Post;
const { Content, headings } = await render(post);
const date = post.data.date.toISOString().slice(0, 10);
const updated = post.data.updated ? post.data.updated.toISOString().slice(0, 10) : undefined;
const rt = readingTime(post.body, lang);
const canonical = postHref(lang, post.id);

// 若属书，则加载书与章节目录、上下章（英文书不存在时按独立文章渲染）
let book: { id: string; title: string; repo?: string } | null = null;
let chapters: Awaited<ReturnType<typeof getBookChapters>> = [];
let adjacent: ReturnType<typeof getAdjacentChapters> = {};

if (post.data.book) {
  const books = await getCollection('books-en');
  const b = books.find((x) => x.data.id === post.data.book);
  if (b) {
    book = { id: b.data.id, title: b.data.title, repo: b.data.repo };
    chapters = await getBookChapters(b.data.id, lang);
    adjacent = getAdjacentChapters(chapters, post.id);
  }
}
const isBook = Boolean(book);

// SEO/GEO：OG 与结构化数据（BlogPosting + 面包屑）
const site = Astro.site ?? new URL('https://geektutu.com');
const publishedTime = post.data.date.toISOString();
const modifiedTime = (post.data.updated ?? post.data.date).toISOString();
const image = post.data.cover
  ? new URL(post.data.cover.src, site).href
  : new URL('/og-default.png', site).href;
const authorLd = { '@type': 'Person', name: 'Geektutu', url: 'https://github.com/geektutu' };
const postLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description || undefined,
  image: [image],
  datePublished: publishedTime,
  dateModified: modifiedTime,
  author: authorLd,
  keywords: post.data.tags.length ? post.data.tags.join(', ') : undefined,
  inLanguage: contentLang[lang],
  mainEntityOfPage: { '@type': 'WebPage', '@id': new URL(canonical, site).href },
  isPartOf: { '@type': 'Blog', '@id': `${site.href}#blog`, name: t.siteName, url: site.href },
};
// 面包屑：Home → Book → Chapter（独立文章为 Home → Chapter）
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t.nav.home, item: new URL('/en/', site).href },
    ...(isBook
      ? [
          {
            '@type': 'ListItem',
            position: 2,
            name: book!.title,
            item: new URL(bookHref(lang, book!.id), site).href,
          },
        ]
      : []),
    { '@type': 'ListItem', position: isBook ? 3 : 2, name: post.data.title },
  ],
};
const toLd = (ld: unknown) => JSON.stringify(ld).replace(/</g, '\\u003c');
// 正文顶部的仓库提示：单篇文章 repo 优先于所属书的 repo
const repo = post.data.repo ?? book?.repo;
// Gitalk issue id：语言前缀区分评论
const commentId = gitalkId(lang, post.id);
// hreflang：仅在存在中文原文时声明 alternate
const zhSlugs = new Set((await getCollection('posts', ({ data }) => !data.draft)).map((p) => p.id));
const alternate = zhSlugs.has(post.id) ? `/post/${post.id}.html` : null;
---

<Layout
  lang={lang}
  title={post.data.title}
  description={post.data.description}
  alternate={alternate}
  ogType="article"
  ogImage={post.data.cover ? post.data.cover.src : undefined}
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
  tags={post.data.tags}
>
  <script type="application/ld+json" is:inline set:html={toLd(postLd)} slot="head" />
  <script type="application/ld+json" is:inline set:html={toLd(breadcrumbLd)} slot="head" />
  <ReadingProgress />

  <div class="mx-auto max-w-6xl px-5">
    {isBook ? (
      <div class="grid grid-cols-1 lg:grid-cols-[260px_1fr] lg:gap-10">
        <aside class="no-print hidden lg:sticky lg:top-20 lg:block lg:self-start">
          <div class="rounded-2xl border border-line bg-paper-soft">
            <div class="book-toc-scroll relative lg:max-h-[calc(100vh-9rem)] lg:overflow-y-auto">
              <ChapterToc
                bookTitle={book!.title}
                bookId={book!.id}
                chapters={chapters}
                currentSlug={post.id}
                lang={lang}
              />
            </div>
          </div>
        </aside>

        <article class="min-w-0 py-12">
          <div class="mx-auto max-w-2xl">
            <ChapterHeader
              post={post}
              lang={lang}
              date={date}
              updated={updated}
              readingTime={rt}
              bookTitle={book!.title}
              bookHref={bookHref(lang, book!.id)}
              repo={repo}
            />
            {post.data.description && (
              <div class="mt-6 rounded-2xl border border-line bg-paper-soft px-5 py-4">
                <p class="text-[0.7rem] font-medium uppercase tracking-widest text-faint">{t.chapter.tldr}</p>
                <p class="mt-1.5 text-[0.95rem] leading-relaxed text-muted">{post.data.description}</p>
              </div>
            )}
            <div class="mt-8">
              <SectionToc headings={headings} lang={lang} />
            <div class="mt-6 markdown"><Content /></div>
          </div>
          <Tip lang={lang} />
          <ChapterNav lang={lang} prev={adjacent.prev} next={adjacent.next} />
            <SaveLastRead bookId={book!.id} slug={post.id} />
            <Gitalk id={commentId} title={post.data.title} lang={lang} />
          </div>
        </article>
      </div>
    ) : (
      <article class="mx-auto max-w-2xl py-14">
        <ChapterHeader post={post} lang={lang} date={date} updated={updated} readingTime={rt} repo={repo} />
        {post.data.description && (
          <div class="mt-6 rounded-2xl border border-line bg-paper-soft px-5 py-4">
            <p class="text-[0.7rem] font-medium uppercase tracking-widest text-faint">{t.chapter.tldr}</p>
            <p class="mt-1.5 text-[0.95rem] leading-relaxed text-muted">{post.data.description}</p>
          </div>
        )}
          <div class="mt-8">
            <SectionToc headings={headings} lang={lang} />
            <div class="mt-6 markdown"><Content /></div>
          </div>
          <Tip lang={lang} />
          <Gitalk id={commentId} title={post.data.title} lang={lang} />
        </article>
    )}
  </div>
</Layout>
