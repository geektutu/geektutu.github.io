---
import Layout from '../../layouts/Layout.astro';
import { getBooks, getPublishedPosts } from '../../lib/books';
import { getDict } from '../../lib/i18n';

const lang = 'en' as const;
const t = getDict(lang);
const books = await getBooks(lang);
const posts = await getPublishedPosts(lang);
const totalChapters = posts.length;

// SEO/GEO：作者实体（E-E-A-T），与文章 JSON-LD 的 author 保持一致
const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Geektutu',
  url: 'https://github.com/geektutu',
  sameAs: ['https://github.com/geektutu'],
};
const toLd = (ld: unknown) => JSON.stringify(ld).replace(/</g, '\\u003c');
---

<Layout lang={lang} title={t.about.title} description={t.about.description} active="about">
  <script type="application/ld+json" is:inline set:html={toLd(personLd)} slot="head" />
  <section class="mx-auto max-w-3xl px-5 py-14">
    <p class="mb-3 text-xs font-medium uppercase tracking-[0.2em] text-accent">{t.about.kicker}</p>
    <h1 class="mb-8 font-display text-4xl font-semibold tracking-tight">{t.about.heading}</h1>

    <div class="space-y-6 text-lg leading-relaxed text-ink">
      <p>{t.about.intro}</p>
      <p class="text-muted">{t.about.tech}</p>
    </div>

    <div class="mt-10 grid grid-cols-3 gap-4 rounded-2xl border border-line bg-paper-soft p-6 text-center">
      <div>
        <p class="font-display text-3xl font-semibold text-accent">{books.length}</p>
        <p class="mt-1 text-sm text-faint">{t.about.statsBook}</p>
      </div>
      <div>
        <p class="font-display text-3xl font-semibold text-accent">{totalChapters}</p>
        <p class="mt-1 text-sm text-faint">{t.about.statsChapter}</p>
      </div>
      <div>
        <p class="font-display text-3xl font-semibold text-accent">{new Set(posts.flatMap((p) => p.data.tags)).size}</p>
        <p class="mt-1 text-sm text-faint">{t.about.statsTag}</p>
      </div>
    </div>

    <div class="mt-10">
      <h2 class="mb-4 font-display text-xl font-semibold">{t.about.authorHeading}</h2>
      <p class="leading-relaxed text-muted">{t.about.author}</p>
    </div>

    <div class="mt-10">
      <h2 class="mb-4 font-display text-xl font-semibold">{t.about.subscribe}</h2>
      <ul class="space-y-2 text-muted">
        <li><a href="/en/feed.xml" class="text-accent underline underline-offset-2">{t.about.rss}</a></li>
        <li><a href="https://github.com/geektutu" target="_blank" rel="noreferrer" class="text-accent underline underline-offset-2">GitHub</a></li>
      </ul>
    </div>
  </section>
</Layout>
