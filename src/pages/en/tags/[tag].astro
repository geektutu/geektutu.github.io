---
import Layout from '../../../layouts/Layout.astro';
import PostCard from '../../../components/PostCard.astro';
import { getPublishedPosts, tagHref } from '../../../lib/books';
import { getDict } from '../../../lib/i18n';

const lang = 'en' as const;
const t = getDict(lang);

export async function getStaticPaths() {
  const posts = await getPublishedPosts('en');
  const tags = new Set<string>();
  for (const p of posts) for (const tg of p.data.tags) tags.add(tg);
  return [...tags].map((tag) => ({ params: { tag } }));
}

const { tag } = Astro.params;
const posts = (await getPublishedPosts(lang)).filter((p) => p.data.tags.includes(tag!));
---

<Layout lang={lang} title={`#${tag}`} description={t.tags.under(tag!)} active="tags" indexable={false}>
  <section class="mx-auto max-w-3xl px-5 py-14">
    <div class="mb-8 flex items-center gap-3">
      <span class="rounded-full bg-accent-soft px-4 py-1 text-sm font-medium text-accent">#{tag}</span>
      <span class="text-sm text-faint">{t.tags.count(posts.length)}</span>
    </div>
    <div class="space-y-4">
      {posts.map((post, i) => (
        <PostCard post={post} index={i} />
      ))}
    </div>
  </section>
</Layout>
