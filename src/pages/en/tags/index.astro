---
import Layout from '../../../layouts/Layout.astro';
import { getPublishedPosts, tagHref } from '../../../lib/books';
import { getDict } from '../../../lib/i18n';

const lang = 'en' as const;
const t = getDict(lang);
const posts = await getPublishedPosts(lang);
const tagCount = new Map<string, number>();
for (const p of posts) {
  for (const tg of p.data.tags) {
    tagCount.set(tg, (tagCount.get(tg) ?? 0) + 1);
  }
}
const tags = [...tagCount.entries()].sort((a, b) => b[1] - a[1]);
const maxCount = Math.max(1, ...tags.map(([, c]) => c));
---

<Layout lang={lang} title={t.tags.title} description={t.tags.description} active="tags" indexable={false}>
  <section class="mx-auto max-w-3xl px-5 py-14">
    <p class="mb-3 text-xs font-medium uppercase tracking-[0.2em] text-accent">Tags</p>
    <h1 class="mb-8 font-display text-4xl font-semibold tracking-tight">{t.tags.title}</h1>

    {tags.length > 0 ? (
      <div class="flex flex-wrap gap-3">
        {tags.map(([tag, count], i) => {
          const size = 0.85 + (count / maxCount) * 0.5;
          return (
            <a
              href={tagHref(lang, tag)}
              class="animate-rise rounded-full border border-line px-4 py-1.5 transition-colors hover:border-accent/40 hover:text-accent"
              style={{ 'animation-delay': `${i * 0.03}s`, 'font-size': `${size}rem` }}
            >
              #{tag}
              <span class="ml-1.5 text-xs text-faint">{count}</span>
            </a>
          );
        })}
      </div>
    ) : (
      <p class="text-muted">{t.tags.empty}</p>
    )}
  </section>
</Layout>
