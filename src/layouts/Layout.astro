---
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  active?: 'home' | 'books' | 'tags' | 'search' | 'about';
  indexable?: boolean;
}

const { title = '极客兔兔', description = '把技术文章组织成书的静态博客', active, indexable = true } = Astro.props;
const siteTitle = title === '极客兔兔' ? title : `${title} · 极客兔兔`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{siteTitle}</title>
    <link rel="icon" type="image/png" href="/icon.png" />
    <link rel="preload" href="/fonts/literata-latin-subset.woff2" as="font" type="font/woff2" crossorigin />
    <!-- 内联防 FOUC：首帧前应用主题 -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var dark = stored ? stored === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (dark) document.documentElement.classList.add('dark');
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="min-h-screen relative" data-pagefind-ignore={indexable ? undefined : 'all'}>
    <div class="paper-grain" aria-hidden="true"></div>
    <div class="relative z-10 flex min-h-screen flex-col">
      <Header active={active} />
      <main class="flex-1"><slot /></main>
      <Footer />
    </div>
  </body>
</html>

<script>
  // 全站公共脚本（主题切换、阅读进度、目录高亮）合并为单个模块
  import '../scripts/site';
</script>
